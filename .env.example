# Copy to .env and change the values. .env is git-ignored; never commit real credentials.
MYSQL_DATABASE=shortlink
MYSQL_USER=shortlink
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
BASE_URL=http://localhost:8080
# Set to true ONLY when running behind a reverse proxy you control (e.g. nginx, ALB).
TRUST_PROXY=false
